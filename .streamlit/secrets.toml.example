# Copy this file to `secrets.toml` in this folder (that file is gitignored).
# Streamlit Cloud: paste the same keys in App settings → Secrets.
#
# Groq: https://console.groq.com/keys
#
# ----- PRODUCTION CHECKLIST (Streamlit Cloud) -----
# [ ] GROQ_API_KEY
# [ ] DATABASE_URL  (Postgres — required on Cloud; see README "PostgreSQL")
# [ ] First admin: either BOOTSTRAP_* below OR use in-app "Create first admin"
# [ ] AUTH_DISABLED unset or false
# [ ] DEBUG_ERRORS unset or false
# [ ] Restart app after saving Secrets
#
# -----------------------------------------------------------------------------

GROQ_API_KEY = "gsk_your_key_here"

# ----- SaaS / persistence -----
# Production: Postgres (Neon, Supabase, Railway, Render, RDS, …).
# URL-encode special chars in PASSWORD (@ → %40, etc.).
# Many hosts need TLS:
# DATABASE_URL = "postgresql+psycopg2://user:pass@host:5432/fluency?sslmode=require"
#
# Also accepted: database_url, database_URL (first non-empty wins).
#
# Bootstrap admin (created automatically on startup if user does not exist yet):
# BOOTSTRAP_ADMIN_EMAIL + BOOTSTRAP_ADMIN_PASSWORD are required for auto-create.
# Optional: BOOTSTRAP_TENANT_SLUG (default "default"), BOOTSTRAP_TENANT_NAME.
# Alternate keys: bootstrap_admin_email, bootstrap_admin_password, etc.
#
# Local dev only: omit DATABASE_URL → app uses sqlite `./fluency.db` (not for Cloud).

# ----- Authentication (recommended for client deployments) -----
# Set these ONCE to bootstrap the very first admin (only used if no users exist yet):
# BOOTSTRAP_TENANT_SLUG = "acme"
# BOOTSTRAP_TENANT_NAME = "Acme Inc"
# BOOTSTRAP_ADMIN_EMAIL = "admin@acme.com"
# BOOTSTRAP_ADMIN_PASSWORD = "change-me"
#
# SaaS self-signup: anyone can open “Create workspace” and register a tenant + admin.
# Set false for invite-only / enterprise.
# SELF_SIGNUP_ENABLED = true

# Email verification (6-digit code via SMTP). New signups must verify before first login unless disabled.
# Gmail: create an App Password (Google Account → Security → 2FA → App passwords), not your normal password.
# SMTP_HOST = "smtp.gmail.com"
# SMTP_PORT = 587
# SMTP_USER = "you@gmail.com"
# SMTP_PASSWORD = "your-16-char-app-password"
# SMTP_FROM = "you@gmail.com"
# Optional pepper so codes can't be replayed if DB leaks: VERIFICATION_CODE_PEPPER = "long-random-string"
# REQUIRE_EMAIL_VERIFICATION = true
# VERIFICATION_LINK_EXPIRY_HOURS = 48

# Dev-only: disable auth entirely (not recommended for SaaS)
# AUTH_DISABLED = false

# ----- Default quotas (applied when a tenant is created) -----
# DEFAULT_GENERATIONS_PER_DAY = 50
# DEFAULT_TRANSCRIPTIONS_PER_DAY = 50
# DEFAULT_VISION_PER_DAY = 50

# ----- Per-user free tier (paywall) -----
# After FREE_TIER_MAX_GENERATIONS successful "Generate SOP" runs and FREE_TIER_MAX_DOWNLOADS
# PDF/DOCX clicks (combined), the UI blocks until the user is exempt or purchases credits.
# FREE_TIER_MAX_GENERATIONS = 3
# FREE_TIER_MAX_DOWNLOADS = 1
# CREDITS_PURCHASE_URL = "https://your-billing-page.example.com"
# FREE_TIER_DISABLED = false   # set true in dev to bypass per-user limits
# Exemption: set column users.paywall_exempt = true (or 1 on SQLite) after payment.

# ----- Smoke test (optional) -----
# Login page shows "Deployment DB: PostgreSQL" vs SQLite — remove after Cloud verify.
# SHOW_DB_HINT = true

# ----- Debugging (disable in production) -----
# If true, shows stack traces to admins (and to anyone if auth is disabled).
# DEBUG_ERRORS = false

# Login failures: shows a small debug expander on failed sign-in (remove after fixing).
# DEBUG_LOGIN = false

# Optional: shared password shown before the app loads (leave unset for no gate).
# APP_ACCESS_PASSWORD = "change-me"

# Stay signed in across browser refresh. On Streamlit Cloud, set a long random secret (e.g. openssl rand -hex 32).
# Local dev: you can omit this — the app will create .streamlit/.session_cookie_secret (gitignored) automatically.
# SESSION_COOKIE_SECRET = "paste-a-long-random-secret-here"
# SESSION_COOKIE_DAYS = 30

# Alternative layout for Groq (instead of top-level GROQ_API_KEY):
# [groq]
# api_key = "gsk_your_key_here"

# ----- White-label branding (optional) -----
# [branding]
# app_name = "Acme SOP Studio"
# tagline = "Operational excellence"
# page_title = "Acme · SOP Studio"
# page_icon = "🚀"
# logo_url = "https://example.com/logo.png"
#
# Local PNG/JPEG/WebP/SVG:
# - Same folder as app.py (project root):  logo_path = "Logo.png"
# - Under .streamlit/:                       logo_path = ".streamlit/logo.png"
# Paths try project root first, then .streamlit/, then cwd. Match filename casing (e.g. Logo.png).
# Streamlit Cloud: commit the image file to Git or use logo_url instead (disk is ephemeral).
# logo_path = "Logo.png"
# primary_color = "#0A74DA"
# secondary_color = "#4338CA"
# accent_color = "#059669"
# hide_powered_by = true
# Label for APP_ACCESS_PASSWORD screen (default: Continue)
# access_gate_button = "Staff Login"
# Sign-in tab submit label (default: Sign in)
# sign_in_button = "Staff Login"

# Env overrides (same keys): BRAND_APP_NAME, BRAND_TAGLINE, BRAND_PAGE_TITLE,
# BRAND_PAGE_ICON, BRAND_LOGO_URL, BRAND_LOGO_PATH, BRAND_PRIMARY_COLOR,
# BRAND_SECONDARY_COLOR, BRAND_ACCENT_COLOR, BRAND_HIDE_POWERED_BY (= true/1/yes),
# BRAND_ACCESS_GATE_BUTTON, BRAND_SIGN_IN_BUTTON
